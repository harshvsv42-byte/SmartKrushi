# ==============================================================================
# SMARTKRUSHI FULL-STACK PROJECT — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file or use frontend/.env and backend/.env individually.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (Django REST Framework)
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-smartkrushi-dev-key-change-in-production-2026!#
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver,*
CORS_ALLOW_ALL_ORIGINS=True

# Weather API settings
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# FRONTEND (React Native / Expo)
# ------------------------------------------------------------------------------
# Android Emulator default:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
# Physical device on LAN (change to your computer's Wi-Fi IPv4 address):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.15:8000/api/v1
