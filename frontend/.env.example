# ==============================================================================
# SMARTKRUSHI MOBILE FRONTEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting Expo:
# cp .env.example .env (or 'copy .env.example .env' in Windows PowerShell)
# ==============================================================================

# 1. For Android Emulator:
# 10.0.2.2 is the special alias to host loopback interface (localhost) in Android Emulator
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# 2. For Physical Android Phone (Expo Go or APK):
# Replace with your computer's local Wi-Fi IPv4 address (run 'ipconfig' to find it):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.15:8000/api/v1

# 3. For Web Browser testing:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
