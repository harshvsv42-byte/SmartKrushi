# ==============================================================================
# SMARTKRUSHI BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the Django server:
# cp .env.example .env (or 'copy .env.example .env' in Windows PowerShell)
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-smartkrushi-dev-key-change-in-production-2026!#
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver,*

# CORS Configuration
# Set to True for development so mobile emulators/devices can connect
CORS_ALLOW_ALL_ORIGINS=True

# Weather API Integrations
# 1. OpenWeather Site API (Optional: add your API key from openweathermap.org)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# 2. Open-Meteo API (Free public fallback, no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Database Configuration (Optional: default is SQLite db.sqlite3)
# To use MySQL instead of SQLite, configure the following:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=smartkrushi_db
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306
